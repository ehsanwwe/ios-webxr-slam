{
  "name": "webarkit",
  "version": "0.0.0-alpha.0",
  "description": "WebXR-grade augmented reality for iOS Safari. Three.js-native AR engine with sensor fusion and visual tracking.",
  "type": "module",
  "main": "src/index.js",
  "module": "src/index.js",
  "types": "types/index.d.ts",
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "import": "./src/index.js"
    }
  },
  "files": [
    "src",
    "types",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build:wasm": "bash src/wasm/build.sh"
  },
  "keywords": [
    "ar",
    "augmented-reality",
    "webxr",
    "ios",
    "ios-safari",
    "slam",
    "three.js",
    "webgl",
    "computer-vision",
    "wasm"
  ],
  "author": {
    "name": "Ehsan Moradi",
    "email": "ehsan.hightech@gmail.com",
    "url": "https://github.com/ehsanwwe"
  },
  "license": "MIT",
  "homepage": "https://github.com/ehsanwwe/ios-webxr-slam",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ehsanwwe/ios-webxr-slam.git"
  },
  "bugs": {
    "url": "https://github.com/ehsanwwe/ios-webxr-slam/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "peerDependencies": {
    "three": ">=0.150.0 <1.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-basic-ssl": "^1.1.0",
    "three": "^0.165.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0",
    "vitest": "^1.5.0"
  }
}
